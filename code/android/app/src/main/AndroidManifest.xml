<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Интернет нужен ТОЛЬКО отладочной сборке: через него загружается
      бандл с машины разработчика. Игра работает полностью локально —
      сетевых вызовов в коде нет, — и в релизе разрешение не
      запрашивается (ТЗ 3.4: только необходимые разрешения).
      Объявление для отладки лежит в src/debug/AndroidManifest.xml.
    -->

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:screenOrientation="portrait"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true" />
      <!--
        Иконка на телефоне — как у питомца ребёнка. Иконку активности
        поменять нельзя, поэтому у неё четыре «псевдонима» с разными
        иконками, и включён ровно один (PetIconModule).
      -->
      <activity-alias
        android:name=".IconCat"
        android:targetActivity=".MainActivity"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconDog"
        android:targetActivity=".MainActivity"
        android:icon="@mipmap/ic_launcher_dog"
        android:roundIcon="@mipmap/ic_launcher_dog_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconPig"
        android:targetActivity=".MainActivity"
        android:icon="@mipmap/ic_launcher_pig"
        android:roundIcon="@mipmap/ic_launcher_pig_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconMonkey"
        android:targetActivity=".MainActivity"
        android:icon="@mipmap/ic_launcher_monkey"
        android:roundIcon="@mipmap/ic_launcher_monkey_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
    </application>
</manifest>
