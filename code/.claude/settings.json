{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",

      "Bash(yarn:*)",
      "Bash(npx:*)",

      "Bash(npx react-native:*)",
      "Bash(npx pod-install:*)",

      "Bash(jest:*)",

      "Bash(./android/gradlew:*)",
      "Bash(adb devices)",
      "Bash(adb logcat:*)",
      "Bash(adb shell:*)",
      "Bash(adb exec-out screencap:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",

      "Read(./src/**)",
      "Read(./docs/**)",
      "Edit(./src/**)",
      "Write(./src/**)",

      "Bash(curl -sS -o /dev/null*)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(./android/gradlew bundleRelease:*)",
      "Write(./production/**)",
      "Write(./android/app/build.gradle)",
      "Write(./ios/*.xcodeproj/**)"
    ],

    "deny": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/google-services.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",

      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git clean -fd:*)"
    ]
  },

  "defaultMode": "acceptEdits"
}
